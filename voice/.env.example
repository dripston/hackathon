# Copy to .env and fill in. Never commit the real .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# polling (local, no public URL) or webhook (public HTTPS service)
TELEGRAM_MODE=polling
# Only used when TELEGRAM_MODE=webhook. Public HTTPS base URL (no trailing slash).
TELEGRAM_WEBHOOK_URL=
# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# --- Groq LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sarvam AI (STT + TTS) ---
SARVAM_API_KEY=
# STT: saaras:v4 (default/recommended) or saaras:v3. Leave blank to use Sarvam's server default.
SARVAM_STT_MODEL=saaras:v4
# STT output mode: transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
# BCP-47 code or "unknown" to auto-detect (handles English, Hindi, Hinglish).
SARVAM_STT_LANGUAGE=unknown
# TTS: bulbul:v2 (speakers: anushka, manisha, abhilash...) | bulbul:v3 (shubh, priya...) | bulbul:v4-flash
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_LANGUAGE=en-IN

# --- Antibody ---
# Operator API the bot reads incidents from and sends approvals to.
ANTIBODY_URL=http://localhost:4000
# Chat to call when a fix waits for approval. Blank: send /oncall in the chat you want called.
ONCALL_CHAT_ID=
ONCALL_POLL_SECONDS=15

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Limits (safe defaults) ---
REQUEST_TIMEOUT_SECONDS=30
MAX_VOICE_DURATION_SECONDS=120
MAX_AUDIO_BYTES=20971520
HISTORY_MAX_MESSAGES=20
MAX_TTS_CHARS=1500
# Set true only when debugging to allow short transcript/preview logging.
LOG_TRANSCRIPTS=false
