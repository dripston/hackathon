NEATLOGS_API_KEY=
NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp
NEATLOGS_TRACE_URL=
# groq (what the team uses; the hackathon AWS account doesn't allow Bedrock) | anthropic | bedrock | stub
LLM_PROVIDER=groq
GROQ_API_KEY=
AWS_REGION=us-east-1
# Either a Bedrock API key, or standard AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE)
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_API_KEY=
MODEL_CHEAP=openai/gpt-oss-20b
MODEL_STRONG=openai/gpt-oss-20b
# USD per million tokens, from your provider's price page (used for the cost cap and cost per incident)
PRICE_CHEAP_IN_PER_MTOK=0.075
PRICE_CHEAP_OUT_PER_MTOK=0.30
PRICE_STRONG_IN_PER_MTOK=0.075
PRICE_STRONG_OUT_PER_MTOK=0.30
PATIENT_URL=http://localhost:5050
SCORER_URL=http://localhost:5050
USE_STUBS=1
GITHUB_REPO=
ANTIBODY_API_PORT=4000
ANTIBODY_STATE_DIR=.state
ANTIBODY_COST_CAP_USD=1.50
CORS_ORIGINS=http://localhost:3000
