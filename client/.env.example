# Live mode and same-origin proxy are the defaults when unset.
# Set NEXT_PUBLIC_USE_MOCK to 1 explicitly for read-only captured samples.
NEXT_PUBLIC_USE_MOCK=
NEXT_PUBLIC_DETECTION_URL=
NEXT_PUBLIC_ANTIBODY_URL=
NEXT_PUBLIC_NEATLOGS_TRACE_URL=
# Server-side proxy targets default to 127.0.0.1:4000 and 127.0.0.1:5050.
ANTIBODY_URL=
DETECTION_URL=
