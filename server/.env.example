SARVAM_API_KEY=
# Groq-backed LLM. Existing GROQ_API_KEY is also accepted.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
# hi-IN supports Hindi/English code-mixed speech; en-IN is also configurable.
SARVAM_TTS_LANGUAGE=hi-IN
# Generate a random token and append ?token=... to the Exotel bot URL.
EXOTEL_WS_TOKEN=
PUBLIC_WSS_URL=wss://your-domain.example/ws/exotel
# Optional additional check against the incoming start event.
EXOTEL_ACCOUNT_SID=
WEATHER_REQUEST_TIMEOUT_SECONDS=4
HANDSHAKE_TIMEOUT_SECONDS=10
CALL_IDLE_TIMEOUT_SECONDS=120
MAX_CALL_SECONDS=3600
LOG_LEVEL=INFO
