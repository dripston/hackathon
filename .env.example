# One .env for the whole repo. Copy this file to .env at the repo root and fill it in.
# Never commit .env. Real process environment variables take precedence over it.
# antibody/, detection/ and voice/ all read this file; each uses only the keys it needs.
# The console (client/) is a Next.js app and reads its own client/.env.local (see client/.env.example).

# ===== Shared: LLM (antibody + detection) =====
# groq (what we run) | deepseek | anthropic | bedrock | stub. Groq and DeepSeek are OpenAI-compatible.
LLM_PROVIDER=groq
# Groq key for the patient agent and Antibody (the voice bot has its own, VOICE_GROQ_API_KEY below).
GROQ_API_KEY=
# Optional: a separate Groq key (from a separate Groq account) for test incidents.
DRILL_GROQ_API_KEY=
DEEPSEEK_API_KEY=
MODEL_CHEAP=openai/gpt-oss-20b
MODEL_STRONG=openai/gpt-oss-20b
# Retries with backoff: Groq's free tier allows 8k tokens/min per key, so calls wait instead of failing.
LLM_MAX_RETRIES=8
# USD per million tokens, from the provider's price page (cost cap and cost per incident).
PRICE_CHEAP_IN_PER_MTOK=0.075
PRICE_CHEAP_OUT_PER_MTOK=0.30
PRICE_STRONG_IN_PER_MTOK=0.075
PRICE_STRONG_OUT_PER_MTOK=0.30
# Only for LLM_PROVIDER=anthropic / bedrock.
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# ===== Shared: neatlogs (antibody + detection) =====
# Project key: tracing, detections and the read-only MCP tools.
NEATLOGS_API_KEY=
NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp
# Optional: a dashboard trace URL with {trace_id} in place of the id (copy one from the neatlogs UI).
NEATLOGS_TRACE_URL=
# Public API service-account token (detection's monitor scripts only).
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_BASE_URL=https://app.neatlogs.com/api/v1/public

# ===== Shared: recordings and CORS =====
# base = real Crustdata recordings; seeded = fictional companies, reported as mock data.
CASSETTE_SET=base
# Origins allowed to call the APIs from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# ===== Antibody core (antibody/, Operator API on :4000) =====
PATIENT_URL=http://localhost:5050
SCORER_URL=http://localhost:5050
# 1 = built-in stubs. 0 = the real patient (falls back to stubs, loudly, if it doesn't answer).
USE_STUBS=0
# owner/repo for PRs; blank = parsed from the origin remote.
GITHUB_REPO=
ANTIBODY_API_PORT=4000
ANTIBODY_STATE_DIR=.state
ANTIBODY_COST_CAP_USD=1.50
# github = push, open a PR, merge on approval. local = commit and merge locally (end-to-end test).
SHIP_TARGET=github
DEPLOY_BRANCH=main
AFTERCARE_AUTO=1

# ===== Detection service + patient agent (detection/, :5050) =====
CRUSTDATA_API_KEY=
CRUSTDATA_MODE=replay
PATIENT_PROMPT_VERSION=v1
BUG_SWALLOW_TOOL_ERRORS=0
DETECTION_PORT=5050
# Risk forecast: error rate per window, fitted over the last 4 windows (5 for a quick demo).
FORECAST_WINDOW_MIN=10
# Jev's Grounded check scores every run when TYPESAFE_API_KEY is set.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_ENABLED=1
# Optional extras for detection's investigation scripts.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
INVESTIGATOR_MODEL=

# ===== Voice on-call bot (voice/, :8000) =====
TELEGRAM_BOT_TOKEN=
# polling (local, no public URL) or webhook (public HTTPS service)
TELEGRAM_MODE=polling
# Only for TELEGRAM_MODE=webhook: public HTTPS base URL (no trailing slash) and the shared secret.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# The voice bot's LLM runs on Groq with its own key (falls back to GROQ_API_KEY).
VOICE_GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SARVAM_API_KEY=
# STT: saaras:v4 (recommended) or saaras:v3. Mode: transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
# BCP-47 code, or "unknown" to auto-detect (English, Hindi, Hinglish).
SARVAM_STT_LANGUAGE=unknown
# TTS: bulbul:v2 (anushka, manisha, abhilash...) | bulbul:v3 (shubh, priya...) | bulbul:v4-flash
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
# Operator API the bot reads incidents from and sends approvals to.
ANTIBODY_URL=http://localhost:4000
# Chat to call when a fix waits for approval. Blank: send /oncall in the chat you want called.
ONCALL_CHAT_ID=
ONCALL_POLL_SECONDS=15
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT_SECONDS=30
MAX_VOICE_DURATION_SECONDS=120
MAX_AUDIO_BYTES=20971520
HISTORY_MAX_MESSAGES=20
MAX_TTS_CHARS=1500
# true only when debugging: allows short transcript previews in logs.
LOG_TRANSCRIPTS=false
