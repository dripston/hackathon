# Copy to .env at the project root. The CLI loads .env automatically.
# Existing process environment variables take precedence.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_BASE_URL=https://app.neatlogs.com/api/v1/public

# Full trace context uses Neatlogs' documented read-only MCP tool.
# This project key is distinct from the Public API service-account token.
NEATLOGS_API_KEY=
NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp

# Select a real Jevals backend explicitly with --jevals-backend vercel or typesafe.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
# The detection service scores every run with Jev's Grounded check when TYPESAFE_API_KEY is set.
JEV_MODEL=jev-latest
JEV_ENABLED=1

# Optional LangChain investigation: enable with --llm-investigation.
OPENAI_API_KEY=
INVESTIGATOR_MODEL=

# --- Patient + Detection API (detection package, /CONTRACT.md :5050) ---
# groq | deepseek (both OpenAI-compatible)
LLM_PROVIDER=groq
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MODEL_CHEAP=openai/gpt-oss-20b
PRICE_CHEAP_IN_PER_MTOK=0.075
PRICE_CHEAP_OUT_PER_MTOK=0.30
CRUSTDATA_API_KEY=
CRUSTDATA_MODE=replay
# base = real recordings (detection record); seeded = fictional companies, reported as mock data
CASSETTE_SET=base
PATIENT_PROMPT_VERSION=v1
BUG_SWALLOW_TOOL_ERRORS=0
DETECTION_PORT=5050
# Risk forecast: error rate per window, fitted over the last 4 windows (5 for a quick demo).
FORECAST_WINDOW_MIN=10
